{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "uipath-validation-request-v1.schema.json",
  "title": "UiPath validation request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "job_id", "project_path", "mode", "tests", "allow_side_effects", "keep_job"],
  "properties": {
    "schema": {"const": "uipath-validation-request/v1"},
    "job_id": {"type": "string", "minLength": 1},
    "project_path": {"type": "string", "minLength": 1},
    "mode": {"enum": ["build", "build-and-test", "run-workflow"]},
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection", "paths"],
      "properties": {
        "selection": {"enum": ["changed", "all", "paths"]},
        "paths": {"type": "array", "items": {"type": "string"}}
      }
    },
    "allow_side_effects": {"type": "boolean"},
    "keep_job": {"type": "boolean"}
  }
}
